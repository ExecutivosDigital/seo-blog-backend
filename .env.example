# --- App ---
PORT=3333
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://seoblog:seoblog@localhost:5432/seoblog?schema=public

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
SECURITY_TOKEN=change-me-server-to-server-token

# --- OpenRouter ---
OPEN_ROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Storage (Cloudflare R2). Quando vazio, fallback p/ LocalDisk ---
STORAGE_DRIVER=local            # 'r2' | 'local'
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:3333/uploads
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AWS_ACCESS_KEY_ID=
CLOUDFLARE_AWS_SECRET_ACCESS_KEY_ID=
AWS_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# --- Admin seed ---
SEED_ADMIN_EMAIL=admin@seoblog.local
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=Admin
